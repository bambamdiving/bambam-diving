# Copy this file to .env.local and fill in real values.
# None of these are required for the site to build and run -
# without them, forms/analytics just gracefully do nothing.

# --- Hidden analytics page (/admin) ---
# Any password you choose to gate the /admin page.
ADMIN_PASSWORD=

# --- Supabase (powers the analytics dashboard) ---
# Create a free project at https://supabase.com, then find these
# under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
